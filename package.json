{
  "name": "malleable-plc-poc",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:db": "docker compose up -d --wait postgres && echo 'Postgres ready on :${PG_PORT:-5433}'",
    "dev:migrate": "DATABASE_URL=postgres://pls:pls@localhost:${PG_PORT:-5433}/malleable_pls pnpm --filter @pls/server run migrate",
    "dev:server": "DATABASE_URL=postgres://pls:pls@localhost:${PG_PORT:-5433}/malleable_pls pnpm --filter @pls/server run dev",
    "dev:web": "VITE_API_URL=http://localhost:3001 VITE_USER_ID=dev-user-1 pnpm --filter @pls/web run dev",
    "e2e:server": "(pnpm run dev:db || echo 'dev:db failed — assuming postgres already up on :${PG_PORT:-5433}') && DATABASE_URL=postgres://pls:pls@localhost:${PG_PORT:-5433}/malleable_pls pnpm --filter @pls/server run migrate-and-start",
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p apps/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ct": "playwright test --config playwright-ct.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^2.2.6",
    "typescript": "~5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
