{
  "name": "@pls/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx ../../packages/db/src/migrate.ts",
    "migrate-and-start": "tsx ../../packages/db/src/migrate.ts && tsx src/index.ts"
  },
  "dependencies": {
    "@pls/db": "workspace:*",
    "@pls/scheduler": "workspace:*",
    "@pls/substrate": "workspace:*",
    "@pls/workflows": "workspace:*",
    "@trpc/server": "^11.19.0",
    "cors": "^2.8.6",
    "postgres": "^3.4.9",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
